<?xml version="1.0"?>
<ruleset name="WT-Otpravkapochtaru">
    <description>Project-local PHPCS configuration using the shared PHP QA rules as the base.</description>

    <file>lib_webtolk_otpravkapochtaru</file>
    <file>plg_system_wt_otpravkapochtaru</file>
    <file>script.php</file>
    <file>tests</file>

    <exclude-pattern type="relative">^\.pf/*</exclude-pattern>
    <exclude-pattern type="relative">^\.webtolk/*</exclude-pattern>
