parameters:
    level: 1
    paths:
        - lib_webtolk_otpravkapochtaru/src
        - plg_system_wtotpravkapochtaru/services
        - plg_system_wtotpravkapochtaru/src
        - script.php
        - tests
    bootstrapFiles:
        - tests/bootstrap.php
    scanDirectories:
        - D:/.agents/docs/joomla/core/Joomla-core/6.x/6.1.0/libraries/src
