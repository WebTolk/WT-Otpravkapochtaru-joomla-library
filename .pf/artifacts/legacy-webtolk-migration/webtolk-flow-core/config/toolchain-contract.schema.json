{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-flow.local/config/toolchain-contract.schema.json",
  "title": "ToolchainContract",
  "type": "object",
  "required": ["toolchain"],
  "properties": {
    "toolchain": {
      "type": "object",
      "required": ["name", "contract_version", "path_resolution", "sources", "logical_tools", "policy"],
      "properties": {
        "name": { "type": "string" },
        "contract_version": { "type": "string" },
        "path_resolution": {
          "type": "object",
          "required": ["base", "relative_only"],
          "properties": {
            "base": { "type": "string" },
            "relative_only": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "sources": {
          "type": "object",
          "required": ["toolchain_definition"],
          "properties": {
            "toolchain_definition": { "type": "string" }
          },
          "additionalProperties": false
        },
        "logical_tools": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["resolves_to", "execution"],
            "properties": {
              "resolves_to": { "type": "string" },
              "execution": {
                "type": "object",
                "required": ["strategy", "command_name"],
                "properties": {
                  "strategy": { "type": "string" },
                  "command_name": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "policy": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
