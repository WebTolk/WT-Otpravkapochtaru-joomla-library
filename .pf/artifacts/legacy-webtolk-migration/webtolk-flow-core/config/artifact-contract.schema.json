{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-flow.local/config/artifact-contract.schema.json",
  "title": "ArtifactContract",
  "type": "object",
  "required": ["stage", "work_mode", "artifacts_in", "artifacts_out", "required_tools", "optional_tools", "allowed_next_skills", "failure_conditions", "quality_gates", "logging_requirements", "tool_policy_overrides", "handoff_contract"],
  "properties": {
    "stage": { "type": "string" },
    "work_mode": { "type": "string" },
    "artifacts_in": { "type": "array", "items": { "type": "string" } },
    "artifacts_out": { "type": "array", "items": { "type": "string" } },
    "required_tools": { "type": "array", "items": { "type": "string" } },
    "optional_tools": { "type": "array", "items": { "type": "string" } },
    "allowed_next_skills": { "type": "array", "items": { "type": "string" } },
    "failure_conditions": { "type": "array", "items": { "type": "string" } },
    "quality_gates": { "type": "array", "items": { "type": "string" } },
    "logging_requirements": { "type": "array", "items": { "type": "string" } },
    "tool_policy_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "boolean", "array"],
        "items": { "type": "string" }
      }
    },
    "handoff_contract": {
      "type": "object",
      "required": ["ready_when", "must_include", "blocks_handoff_when"]
    }
  },
  "additionalProperties": false
}
