{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-flow.local/config/tool-run.schema.json",
  "title": "ToolRun",
  "type": "object",
  "required": ["tool_name", "operation", "files", "fallback", "reason"],
  "properties": {
    "tool_name": { "type": "string" },
    "operation": { "type": "string" },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fallback": { "type": "boolean" },
    "reason": { "type": "string" }
  },
  "additionalProperties": false
}
