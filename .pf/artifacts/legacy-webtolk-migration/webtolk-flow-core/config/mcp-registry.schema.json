{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-flow.local/config/mcp-registry.schema.json",
  "title": "McpRegistry",
  "type": "object",
  "required": ["registry", "servers"],
  "properties": {
    "registry": {
      "type": "object",
      "required": ["scope", "version"]
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "required_for", "fallback_policy"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "required_for": {
            "type": "array",
            "items": { "type": "string" }
          },
          "fallback_policy": {
            "type": "object",
            "required": ["allowed", "fallback_to", "record_telemetry"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
